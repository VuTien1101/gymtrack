DATABASE_URL="postgresql://postgres:password@localhost:5432/gymtrack"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000

# SMTP is optional in development. Gmail requires an app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="GymTrack <your-email@example.com>"

# Optional: npm run seed creates or promotes this account to ADMIN.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="GymTrack Admin"

# Optional: SMS OTP with Twilio.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM="+15005550006"